# PostgreSQL connection used by Prisma. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://booking:booking@localhost:5432/booking?schema=public"

# IANA name of the office timezone. Business hours and slot validation are checked against it.
OFFICE_TIME_ZONE="Europe/Kyiv"

# Minutes before a booking ends to notify its author if the next slot in the room is taken.
NOTIFY_BEFORE_MINUTES=10

# Only used by the integration test suite (npm run test:integration), against the
# postgres-test service (docker compose --profile test up -d postgres-test).
TEST_DATABASE_URL="postgresql://booking:booking@localhost:5433/booking_test?schema=public"
